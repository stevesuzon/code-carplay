{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-generateur",
  "main": "src/index.js",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REMPLACE_PAR_TA_BASE_D1",
      "database_id": "REMPLACE_PAR_ID_D1"
    }
  ]
}
